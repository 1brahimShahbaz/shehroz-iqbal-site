# Next.js static export on Apache / Hostinger (LiteSpeed)
Options -MultiViews

# Serve ES modules as JavaScript. Without this the host returns text/plain for
# .mjs, and browsers reject the PDF.js module worker → "Could not load this PDF".
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # FIX 2: Single-hop redirect to canonical https://zarakmushtaq.com
  # (catches http://, www., and http://www. in one 301 — no chains)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # FIX 3: *.html variants 301 to the clean canonical URL
  # (THE_REQUEST check = only direct requests, so internal rewrites below don't loop)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # FIX 1: /notes app page — serve notes.html even when public/notes/ (PDF assets) exists
  RewriteRule ^notes/?$ notes.html [L]

  # Serve page.html when a same-name folder exists (fixes 403 on /about, /courses/*, etc.)
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Fallback: path has no file, try adding .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<Files "sitemap.xml">
  <IfModule mod_headers.c>
    Header set Content-Type "application/xml; charset=utf-8"
  </IfModule>
</Files>

# Next.js RSC payload files (.txt) are for client-side navigation only —
# tell Google not to index them so they stop appearing as crawled duplicates.
<FilesMatch "\.txt$">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex"
  </IfModule>
</FilesMatch>

ErrorDocument 404 /404.html
