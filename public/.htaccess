# Next.js static export on Apache / Hostinger (LiteSpeed)
Options -MultiViews

# Serve ES modules as JavaScript. Without this the host returns text/plain for
# .mjs, and browsers reject the PDF.js module worker → "Could not load this PDF".
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # FIX 2: Single-hop redirect to canonical https://zarakmushtaq.com
  # (catches http://, www., and http://www. in one 301 — no chains)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # FIX 4: Legacy URL 301 redirects (routes renamed for SEO — Aug 2026)
  # Placed before the .html rules so old URLs redirect in a single hop.
  RewriteRule ^about(?:\.html)?/?$ /about-shehroz-iqbal [R=301,L]
  RewriteRule ^courses/as-level(?:\.html)?/?$ /courses/as-level-accounting-course [R=301,L]
  RewriteRule ^courses/a2-level(?:\.html)?/?$ /courses/a2-level-accounting-course [R=301,L]
  RewriteRule ^courses/o-level(?:\.html)?/?$ /courses/o-level-accounting-course [R=301,L]

  # FIX 3: *.html variants 301 to the clean canonical URL
  # (THE_REQUEST check = only direct requests, so internal rewrites below don't loop)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # Serve page.html when a same-name folder exists (fixes 403 on /about, /courses/*, etc.)
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Fallback: path has no file, try adding .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<Files "sitemap.xml">
  <IfModule mod_headers.c>
    Header set Content-Type "application/xml; charset=utf-8"
  </IfModule>
</Files>

# Next.js RSC payload files (.txt) are for client-side navigation only —
# tell Google not to index them so they stop appearing as crawled duplicates.
<FilesMatch "\.txt$">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex"
  </IfModule>
</FilesMatch>

ErrorDocument 404 /404.html

# ─────────────────────────────────────────────────────────────
# Performance: compression (gzip + Brotli where available)
# ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    text/javascript application/javascript application/json \
    application/xml application/rss+xml image/svg+xml \
    application/x-font-ttf application/vnd.ms-fontobject \
    font/ttf font/otf font/woff font/woff2
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    text/javascript application/javascript application/json \
    application/xml image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ─────────────────────────────────────────────────────────────
# Caching: far-future expiry for static assets, revalidate HTML
# ─────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/gif                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Versioned, content-hashed static assets → cache hard.
  <FilesMatch "\.(?:css|js|mjs|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images (filenames are stable; bump the name when you replace one).
  <FilesMatch "\.(?:webp|avif|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML pages (static export) should always revalidate.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
